{% if tag is defined %}
image:
  fingerprint:
    tag: "{{ tag }}"
{% endif %}
    repository: {{ registry }}

{% if use_alternate_tagging is defined %}
alternateTagging: {{ use_alternate_tagging }}
{% endif %}

{% if tdx.coco.enabled %}
tdx:
  common:
    kbsAddress: {{ KBS_ADDRESS }}
{% endif %}

ferretdb:
  postgresql:
    auth:
      password: "{{ FINGERPRINT_POSTGRES_PASSWORD }}"

{# Resolve solution language: explicit value or auto-detect from LLM model name #}
{% if solution_language is defined and solution_language != "auto" %}
{%   set resolved_language = solution_language %}
{% elif 'PLLuM' in llm_model or 'Bielik' in llm_model %}
{%   set resolved_language = 'pl' %}
{% else %}
{%   set resolved_language = 'en' %}
{% endif %}

systemFingerprint:
  templateLanguage: "{{ resolved_language }}"

{% if tdx.coco.enabled %}
  podAnnotations:
    io.katacontainers.config.hypervisor.kernel_params: "agent.guest_components_rest_api=all agent.aa_kbc_params=cc_kbc::{{ KBS_ADDRESS }}"
{% endif %}

{% if fingerprint.additional_values is defined %}
{{ fingerprint.additional_values | to_nice_yaml }}
{% endif %}

{% if (minimal_configuration is defined and minimal_configuration) and "cpu" in pipelines[0].samplePath %}
minimalConfiguration: true
minimalResources:
  fingerprint-svc:
    requests:
      cpu: "50m"
{% endif %}
