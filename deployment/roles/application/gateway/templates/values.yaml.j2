gateway:
  serviceType: {{ gateway.serviceType }}
  externalTrafficPolicy: {{ gateway.externalTrafficPolicy }}
  hostPort:
    enabled: {{ gateway.hostPort.enabled | lower }}
    httpPort: {{ gateway.hostPort.httpPort }}
    httpsPort: {{ gateway.hostPort.httpsPort }}
  listenerTuning:
    enabled: {{ gateway.listenerTuning.enabled | lower }}
    listenerFiltersTimeout: {{ gateway.listenerTuning.listenerFiltersTimeout | default('30s') | string | tojson }}
    continueOnTimeout: {{ gateway.listenerTuning.continueOnTimeout | lower }}
    initialReadBufferSize: {{ gateway.listenerTuning.initialReadBufferSize | default(65535) }}

image:
  repository: {{ registry }}
  name: erag-init-container
  tag: {{ tag }}

routes:
  - name: seaweedfs-admin-route
    enabled: {{ (edp.enabled | default(false) and (edp.storageType | default('seaweedfs')) == 'seaweedfs') | lower }}
    namespace: seaweedfs
    hostnames:
{% if routing_mode | default('subdomain') == 'path' %}
      - "{{ FQDN }}"
{% else %}
      - "{{ (edp.uiBrowserDomainPrefix | default('seaweedfs')) ~ '.' ~ FQDN }}"
{% endif %}
    rules:
{% if routing_mode | default('subdomain') == 'path' %}
      - path: {{ edp.seaweedfsPathPrefix | default('/seaweedfs') }}
        pathType: PathPrefix
        backendRef:
          name: seaweedfs-admin
          port: 23646
{% else %}
      - path: /
        pathType: PathPrefix
        backendRef:
          name: seaweedfs-admin
          port: 23646
{% endif %}

  - name: seaweedfs-s3-route
    enabled: {{ (edp.enabled | default(false) and (edp.storageType | default('seaweedfs')) == 'seaweedfs') | lower }}
    namespace: seaweedfs
    hostnames:
{% if routing_mode | default('subdomain') == 'path' %}
      - "{{ FQDN }}"
{% else %}
      - "{{ (edp.s3DomainPrefix | default('s3')) ~ '.' ~ FQDN }}"
{% endif %}
    rules:
{% if routing_mode | default('subdomain') == 'path' %}
      - path: {{ edp.s3PathPrefix | default('/s3') }}
        pathType: PathPrefix
        urlRewrite:
          replacePrefixMatch: /
        backendRef:
          name: seaweedfs-s3
          port: 8333
{% else %}
      - path: /
        pathType: PathPrefix
        backendRef:
          name: seaweedfs-s3
          port: 8333
{% endif %}
