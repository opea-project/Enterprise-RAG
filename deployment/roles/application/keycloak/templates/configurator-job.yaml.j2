---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "create", "update", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: keycloak-configurator
subjects:
  - kind: ServiceAccount
    name: keycloak-configurator
    namespace: {{ keycloak_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-configurator-script
  namespace: {{ keycloak_namespace }}
data:
  configurator.sh: |
{{ lookup('file', role_path + '/files/keycloak_configurator_job.sh') | indent(4, first=True) }}
{% if (keycloak_oidc_endpoint is defined and keycloak_oidc_endpoint) or
      (keycloak_federation_endpoint is defined and keycloak_federation_endpoint) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-configurator-sensitive
  namespace: {{ keycloak_namespace }}
  labels:
    app.kubernetes.io/name: keycloak-configurator
    app.kubernetes.io/component: configuration
type: Opaque
data:
{% if keycloak_oidc_endpoint is defined and keycloak_oidc_endpoint %}
  oidc-client-secret: {{ keycloak_oidc_client_secret | default('') | b64encode }}
{% endif %}
{% if keycloak_federation_endpoint is defined and keycloak_federation_endpoint %}
  federation-bind-password: {{ keycloak_federation_bind_password | default('') | b64encode }}
{% endif %}
{% endif %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ configurator_job_name }}
  namespace: {{ keycloak_namespace }}
  labels:
    app.kubernetes.io/name: keycloak-configurator
    app.kubernetes.io/component: configuration
spec:
  backoffLimit: 3
  template:
    metadata:
      labels:
        app.kubernetes.io/name: keycloak-configurator
    spec:
      serviceAccountName: keycloak-configurator
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: configurator
          image: {{ init_container_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          command: ["/bin/bash", "/scripts/configurator.sh"]
          env:
            - name: KEYCLOAK_URL
              value: "http://keycloak-http.{{ keycloak_namespace }}.svc:80{{ keycloak_path_prefix | default('') }}"
            - name: KEYCLOAK_ADMIN_USER
              value: "{{ keycloak_admin_user }}"
            - name: KEYCLOAK_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ keycloak_admin_secret_name }}
                  key: admin-password
            - name: MINIO_DOMAIN
              value: "{{ minio_domain }}"
{% if minio_path_prefix is defined %}
            - name: MINIO_PATH_PREFIX
              value: "{{ minio_path_prefix }}"
{% endif %}
            - name: CREDENTIALS_SECRET_NAME
              value: "{{ credentials_secret_name }}"
            - name: CREDENTIALS_SECRET_NAMESPACE
              value: "{{ keycloak_namespace }}"
{% if keycloak_oidc_endpoint is defined and keycloak_oidc_endpoint %}
            - name: OIDC_ENDPOINT
              value: "{{ keycloak_oidc_endpoint }}"
            - name: OIDC_ALIAS
              value: "{{ keycloak_oidc_alias | default('enterprise-sso') }}"
            - name: OIDC_CLIENT_ID
              value: "{{ keycloak_oidc_client_id | default('') }}"
            - name: OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: keycloak-configurator-sensitive
                  key: oidc-client-secret
            - name: OIDC_ADMIN_GID
              value: "{{ keycloak_oidc_admin_gid | default('') }}"
            - name: OIDC_MAINTAINER_GID
              value: "{{ keycloak_oidc_maintainer_gid | default('') }}"
            - name: OIDC_USER_GID
              value: "{{ keycloak_oidc_user_gid | default('') }}"
{% endif %}
{% if keycloak_federation_endpoint is defined and keycloak_federation_endpoint %}
            - name: FEDERATION_ENDPOINT
              value: "{{ keycloak_federation_endpoint }}"
            - name: FEDERATION_BIND_DN
              value: "{{ keycloak_federation_bind_dn | default('') }}"
            - name: FEDERATION_BIND_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-configurator-sensitive
                  key: federation-bind-password
            - name: FEDERATION_USERS_DN
              value: "{{ keycloak_federation_users_dn | default('') }}"
            - name: FEDERATION_USER_ATTRIBUTE
              value: "{{ keycloak_federation_user_attribute | default('sAMAccountName') }}"
            - name: FEDERATION_GROUPS_DN
              value: "{{ keycloak_federation_groups_dn | default('') }}"
            - name: FEDERATION_USER_GROUP_LDAP_FILTER
              value: "{{ keycloak_federation_user_group_ldap_filter | default('(cn=erag-user-group)') }}"
            - name: FEDERATION_MAINTAINER_GROUP_LDAP_FILTER
              value: "{{ keycloak_federation_maintainer_group_ldap_filter | default('(cn=erag-maintainer-group)') }}"
            - name: FEDERATION_ADMIN_GROUP_LDAP_FILTER
              value: "{{ keycloak_federation_admin_group_ldap_filter | default('(cn=erag-admin-group)') }}"
{% endif %}
{% if httpProxy is defined and httpProxy != "" %}
            - name: http_proxy
              value: "{{ httpProxy }}"
{% endif %}
{% if httpsProxy is defined and httpsProxy != "" %}
            - name: https_proxy
              value: "{{ httpsProxy }}"
{% endif %}
{% if noProxy is defined and noProxy != "" %}
            - name: no_proxy
              value: "{{ noProxy }}"
{% endif %}
          volumeMounts:
            - name: scripts
              mountPath: /scripts
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: scripts
          configMap:
            name: keycloak-configurator-script
            defaultMode: 0555
        - name: tmp
          emptyDir: {}
