---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "create", "update", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: keycloak-configurator
subjects:
  - kind: ServiceAccount
    name: keycloak-configurator
    namespace: {{ keycloak_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-get-secret-script
  namespace: {{ keycloak_namespace }}
data:
  get-secret.sh: |
{{ lookup('file', role_path + '/files/get_client_secret_job.sh') | indent(4, first=True) }}
{% if get_secret_target_namespace != keycloak_namespace %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: keycloak-get-secret
  namespace: {{ get_secret_target_namespace }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "create", "update", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: keycloak-get-secret
  namespace: {{ get_secret_target_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: keycloak-get-secret
subjects:
  - kind: ServiceAccount
    name: keycloak-configurator
    namespace: {{ keycloak_namespace }}
{% endif %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ get_secret_job_name }}
  namespace: {{ keycloak_namespace }}
  labels:
    app.kubernetes.io/name: keycloak-get-secret
    app.kubernetes.io/component: configuration
spec:
  ttlSecondsAfterFinished: 300
  backoffLimit: 3
  template:
    metadata:
      labels:
        app.kubernetes.io/name: keycloak-get-secret
    spec:
      serviceAccountName: keycloak-configurator
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: get-secret
          image: {{ init_container_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          command: ["/bin/bash", "/scripts/get-secret.sh"]
          env:
            - name: KEYCLOAK_URL
              value: "http://keycloak-http.{{ keycloak_namespace }}.svc:80{{ keycloak_path_prefix | default('') }}"
            - name: KEYCLOAK_REALM
              value: "{{ keycloak.realm | default('EnterpriseRAG') }}"
            - name: KEYCLOAK_ADMIN_USER
              value: "{{ keycloak_admin_user }}"
            - name: KEYCLOAK_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ keycloak_admin_secret_name }}
                  key: admin-password
            - name: CLIENT_NAME
              value: "{{ keycloak_client_id }}"
            - name: SECRET_NAME
              value: "{{ client_secret_name }}"
            - name: SECRET_NAMESPACE
              value: "{{ get_secret_target_namespace }}"
            - name: SECRET_KEY
              value: "{{ client_secret_key }}"
          volumeMounts:
            - name: scripts
              mountPath: /scripts
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: scripts
          configMap:
            name: keycloak-get-secret-script
            defaultMode: 0555
        - name: tmp
          emptyDir: {}
