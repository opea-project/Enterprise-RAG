namespace: {{ item.namespace }}
{% set bmg_enabled = (is_bmg_platform_enable | default(is_bmg_platform | default(false)) | bool) or (application_bmg_pipeline_detected | default(false) | bool) %}
is_bmg_platform_enable: {{ bmg_enabled }}
is_bmg_platform: {{ bmg_enabled }}

proxy:
  httpProxy: {{ httpProxy }}
  httpsProxy: {{ httpsProxy }}
  noProxy: {{ noProxy }}
{% if (huggingToken is defined) and (huggingToken != "") %}
tokens:
  hugToken: {{ huggingToken }}
{% endif %}
common_tag: &tag {{ tag }}
common_registry: &repo {{ registry }}

{% if use_alternate_tagging is defined %}
alternateTagging: {{ use_alternate_tagging }}
{% endif %}

{# Resolve solution language: explicit value or auto-detect from LLM model name #}
{% if solution_language is defined and solution_language != "auto" %}
{%   set resolved_language = solution_language %}
{% elif 'PLLuM' in llm_model or 'Bielik' in llm_model %}
{%   set resolved_language = 'pl' %}
{% else %}
{%   set resolved_language = 'en' %}
{% endif %}

llm_model: &cpu_model {{ llm_model }}
llm_model_xpu: &xpu_model {{ llm_model_xpu | default(llm_model) }}
llm_model_gaudi: &hpu_model {{ llm_model_gaudi }}
embedding_model_name: &embedding_model_name {{ embedding_model_name }}
reranking_model_name: &reranking_model_name {{ reranking_model_name }}
ner_model_name: &ner_model_name "tanaos/tanaos-NER-v1"

chat_history:
  enabled: {{ chat_history.enabled }}

{% if hpaEnabled is defined %}
hpaEnabled: {{ hpaEnabled }}
{% endif %}

{% if (minimal_configuration is defined and minimal_configuration) and "cpu" in item.samplePath %}
resources:
  requests:
    cpu: "100m"
    memory: "64Mi"
  limits:
    memory: "128Mi"
{% endif %}

{% if tdx is defined and tdx.coco is defined and tdx.coco.enabled %}
tdx:
  common:
    kbsAddress: {{ KBS_ADDRESS }}
{% endif %}

{% if balloons is defined and balloons.enabled %}
balloons:
  enabled: {{ balloons.enabled }}
  namespace: {{ balloons.namespace }}
  wait_timeout: {{ balloons.wait_timeout }}
{% if balloons_chart_name is defined %}
  chart_name: {{ balloons_chart_name }}
{% endif %}
{% endif %}

{% if optimal_replicas is defined and (optimal_replicas | length) > 0 %}
vllmNodes:
{% for node_name, node_info in optimal_replicas.items() %}
{% if node_info is mapping and node_info.replicas is defined and node_info.adjusted_vllm_size is defined and node_info.adjusted_vllm_size > 0 and (node_info.amx_supported == true or node_info.gaudi == true) %}
  - name: {{ node_name }}
    nodeSelector:
      kubernetes.io/hostname: {{ node_name }}
    VLLM_CPU: "{{ node_info.adjusted_vllm_size }}"
    VLLM_INSTANCES: {{ node_info.replicas }}
{% endif %}
{% endfor %}
{% endif %}

{% if gmc.pvc is defined and gmc.pvc.models is defined %}
pvc:
{% for key, val in gmc.pvc.models.items() %}
  {{ key }}:
    name: {{ val.name }}
    storage: {{ val.storage }}
    accessMode: {{ val.accessMode if val.accessMode is defined else gmc.pvc.accessMode }}
{% endfor %}
{% endif %}

images:
  gmcManager:
    image: "erag-gmcmanager"
    repository: *repo
    tag: *tag
  gmcRouter:
    image: "erag-gmcrouter"
    repository: *repo
    tag: *tag
  text-extractor-usvc:
    image: "erag-text-extractor"
    repository: *repo
    tag: *tag
{% if audio.enabled is defined and audio.enabled %}
    envs:
      ASR_MODEL_SERVER_ENDPOINT: "http://asr-svc.{{ audio.namespace }}.svc:9009"
{% endif %}
  text-compression-usvc:
    image: "erag-text-compression"
    repository: *repo
    tag: *tag
  text-splitter-usvc:
    image: "erag-text-splitter"
    repository: *repo
    tag: *tag
  embedding-usvc:
    image: "erag-embedding"
    repository: *repo
    tag: *tag
    envs:
      EMBEDDING_MODEL_NAME: *embedding_model_name
  reranking-usvc:
    image: "erag-reranking"
    repository: *repo
    tag: *tag
    envs:
      RERANKING_MODEL_NAME: *reranking_model_name
{% if edp.late_chunking.enabled is true %}
      RERANKING_LATE_CHUNKING_ENABLED: "True"
{% else %}
      RERANKING_LATE_CHUNKING_ENABLED: "False"
{% endif %}
  teirerank:
    image: "erag-teirerank"
    repository: *repo
    tag: *tag
    envs:
      MODEL_ID: *reranking_model_name
  teirerank_gaudi:
    image: "erag-teirerank_gaudi"
    repository: *repo
    tag: *tag
    envs:
      MODEL_ID: *reranking_model_name
  prompt-template-usvc:
    image: "erag-prompt_template"
    repository: *repo
    tag: *tag
    envs:
      PROMPT_TEMPLATE_LANGUAGE: "{{ resolved_language }}"
  torchserve_embedding:
    image: "erag-torchserve_embedding"
    repository: *repo
    tag: *tag
    envs:
      TORCHSERVE_MODEL_NAME: *embedding_model_name
  vllm_embedding:
    envs:
      EMBEDDING_VLLM_MODEL_NAME: *embedding_model_name
  tei:
    envs:
      MODEL_ID: *embedding_model_name
  torchserve_reranking:
    image: "erag-torchserve_reranking"
    repository: *repo
    tag: *tag
    envs:
      TORCHSERVE_MODEL_NAME: *reranking_model_name
  vllm_reranking:
    envs:
      RERANKING_VLLM_MODEL_NAME: *reranking_model_name
  retriever-usvc:
    image: "erag-retriever"
    repository: *repo
    tag: *tag
{% if vector_databases.enabled %}
    vector_store: {{ vector_databases.vector_store }}
{% endif %}
    envs:
      EMBEDDING_MODEL_NAME: *embedding_model_name
      METADATA_LANGUAGE: "{{ resolved_language }}"
{% if ner is defined and ner.enabled is defined and ner.enabled is true %}
      METADATA_EXTRACTION_MODE: "hybrid"
      NER_ENDPOINT: "http://retriever-ner-ovms-svc:9001"
{% else %}
      METADATA_EXTRACTION_MODE: "off"
{% endif %}
{% if edp.hierarchical_indices.enabled is true %}
      USE_HIERARCHICAL_INDICES: "True"
      K_SUMMARIES: {{ edp.hierarchical_indices.kSummaries }}
      K_CHUNKS: {{ edp.hierarchical_indices.kChunks }}
{% endif %}
{% if edp.rbac is defined and edp.rbac.enabled is true %}
      VECTOR_DB_RBAC: "true"
{% endif %}
{% if vector_databases.enabled %}
      VECTOR_STORE: {{ vector_databases.vector_store }}
      VECTOR_DATATYPE: {{ vector_databases.vector_datatype }}
      VECTOR_DIMS: {{ vector_databases.vector_dims }}
{% endif %}
{% if edp.ingestion.config is defined and edp.ingestion.config.vector_algorithm is defined %}
      VECTOR_ALGORITHM: {{ edp.ingestion.config.vector_algorithm }}
      VECTOR_DISTANCE_METRIC: {{ edp.ingestion.config.vector_distance_metric | default("COSINE") }}
{% endif %}
{% if edp.ingestion.config.vector_algorithm is defined and edp.ingestion.config.vector_algorithm == "SVS-VAMANA" %}
      VECTOR_SVS_GRAPH_MAX_DEGREE: {{ edp.ingestion.config.vector_svs_graph_max_degree | default("40") }}
      VECTOR_SVS_CONSTRUCTION_WINDOW_SIZE: {{ edp.ingestion.config.vector_svs_construction_window_size | default("250") }}
      VECTOR_SVS_SEARCH_WINDOW_SIZE: {{ edp.ingestion.config.vector_svs_search_window_size | default("200") }}
      VECTOR_SVS_COMPRESSION: {{ edp.ingestion.config.vector_svs_compression | default("NO_COMPRESSION") }}
{% endif %}
{% if edp.ingestion.config.vector_algorithm is defined and edp.ingestion.config.vector_algorithm == "HNSW" %}
      VECTOR_HNSW_M: {{ edp.ingestion.config.vector_hnsw_m | default("16") }}
      VECTOR_HNSW_EF_CONSTRUCTION: {{ edp.ingestion.config.vector_hnsw_ef_construction | default("200") }}
      VECTOR_HNSW_EF_RUNTIME: {{ edp.ingestion.config.vector_hnsw_ef_runtime | default("10") }}
      VECTOR_HNSW_EPSILON: {{ edp.ingestion.config.vector_hnsw_epsilon | default("0.01") }}
{% endif %}
  llm-usvc:
    image: "erag-llm"
    repository: *repo
    tag: *tag
  in-guard-usvc:
    image: "erag-in-guard"
    repository: *repo
    tag: *tag
  out-guard-usvc:
    image: "erag-out-guard"
    repository: *repo
    tag: *tag
  ui-usvc:
    image: "erag-chatqna-conversation-ui"
    repository: *repo
    tag: *tag
  vllm_gaudi:
    image: "erag-vllm-gaudi"
    repository: *repo
    tag: *tag
    envs:
      LLM_VLLM_MODEL_NAME: *hpu_model
  vllm:
    image: "erag-vllm-cpu"
    repository: *repo
    tag: *tag
    envs:
      LLM_VLLM_MODEL_NAME: *cpu_model
  vllm_xpu:
    image: "vllm"
    repository: "intel"
    tag: "0.14.1-xpu"
    envs:
      LLM_VLLM_MODEL_NAME: *xpu_model
  langdtct-usvc:
    image: "erag-language-detection"
    repository: *repo
    tag: *tag
  fingerprint-usvc:
    image: "erag-system-fingerprint"
    repository: *repo
    tag: *tag
    envs:
      SYSTEM_FINGERPRINT_TEMPLATE_LANGUAGE: "{{ resolved_language }}"
  chat-history-usvc:
    image: "erag-chat-history"
    repository: *repo
    tag: *tag
  docsum-usvc:
    image: "erag-docsum"
    repository: *repo
    tag: *tag
  query-rewrite-usvc:
    image: "erag-query-rewrite"
    repository: *repo
    tag: *tag
  vllm_query_rewrite:
    image: "erag-vllm-cpu"
    repository: *repo
    tag: *tag
  init-container:
    image: "erag-init-container"
    repository: *repo
    tag: *tag
    pullPolicy: Always
  late-chunking-usvc:
    image: "erag-late-chunking"
    repository: *repo
    tag: *tag
    envs:
      EMBEDDING_MODEL_NAME: *embedding_model_name
  ovms_ner:
    image: "erag-ovms_ner"
    repository: *repo
    tag: *tag
    pullPolicy: Always
    envs:
      NER_MODEL_NAME: *ner_model_name
      NER_WEIGHT_FORMAT: "int8"
      OVMS_INTERNAL_PORT: "9000"
      GATEWAY_PORT: "9001"
