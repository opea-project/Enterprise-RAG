## Embedding Microservice Settings

EMBEDDING_MODEL_NAME="nomic-ai/nomic-embed-text-v1"
EMBEDDING_MODEL_SERVER=vllm
EMBEDDING_MODEL_SERVER_ENDPOINT=http://localhost:8108

## Authentication for a remote (external) vLLM embedding endpoint.
## Provide a static API key (overrides OAuth settings below), or OAuth client credentials.
#EMBEDDING_VLLM_API_KEY=<your-api-key>
#EMBEDDING_VLLM_CLIENT_ID=<your-client-id>
#EMBEDDING_VLLM_CLIENT_SECRET=<your-client-secret>
#EMBEDDING_VLLM_TOKEN_URL=<your-token-url>

## Uncomment to change the microservice port
#EMBEDDING_USVC_PORT=6000
