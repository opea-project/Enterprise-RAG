## Reranking Microservice Settings
RERANKING_SERVICE_ENDPOINT="http://127.0.0.1:8090"
RERANKING_MODEL_SERVER="torchserve"
RERANKING_MODEL_NAME="BAAI/bge-reranker-base"
RERANKING_LATE_CHUNKING_ENABLED="False" # True or False

## Authentication for a remote (external) vLLM reranking endpoint.
## Provide a static API key (overrides OAuth settings below), or OAuth client credentials.
#RERANKING_VLLM_API_KEY=<your-api-key>
#RERANKING_VLLM_CLIENT_ID=<your-client-id>
#RERANKING_VLLM_CLIENT_SECRET=<your-client-secret>
#RERANKING_VLLM_TOKEN_URL=<your-token-url>

## Uncomment to change the microservice port
#RERANKING_USVC_PORT=8000
