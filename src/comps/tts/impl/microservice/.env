## TTS Microservice Settings
TTS_MODEL_SERVER="fastapi"
TTS_MODEL_SERVER_ENDPOINT="http://localhost:8008"

## Uncomment to change the microservice port
#TTS_USVC_PORT=9009

## Maximum allowed input text length in characters. Requests exceeding this limit will be rejected
## with HTTP 400. Set this to protect the service from excessively long payloads that would cause
## timeouts or OOM errors during inference.
#TTS_MAX_INPUT_CHARACTERS=8192

## Uncomment to change the microservice log level
# OPEA_LOGGER_LEVEL=INFO
