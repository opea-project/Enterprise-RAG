## MCP Gateway Settings

# Internal EDP endpoint (cluster-internal)
EDP_ENDPOINT=

# Internal ChatQnA router endpoint (cluster-internal)
# Leave empty when ChatQnA pipeline is not deployed
CHATQNA_ENDPOINT=

# MCP server identity
MCP_SERVER_PORT=8000

# Keycloak token endpoint (injected at runtime via Helm values)
KEYCLOAK_TOKEN_ENDPOINT=

## Uncomment to change log level
# OPEA_LOGGER_LEVEL=INFO
